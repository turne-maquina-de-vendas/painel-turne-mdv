{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/medir?parte=1",
      "schedule": "0 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=2",
      "schedule": "8 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=3",
      "schedule": "16 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=4",
      "schedule": "24 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=5",
      "schedule": "32 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=6",
      "schedule": "40 5,17 * * *"
    },
    {
      "path": "/api/medir?parte=7",
      "schedule": "48 5,17 * * *"
    },
    {
      "path": "/api/videos?varrer=1",
      "schedule": "5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/arts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/conteudo/acervo.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/conteudo/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
