{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    { "path": "/api/medir?parte=1", "schedule": "0 5 */3 * *" },
    { "path": "/api/medir?parte=2", "schedule": "10 5 */3 * *" },
    { "path": "/api/medir?parte=3", "schedule": "20 5 */3 * *" },
    { "path": "/api/medir?parte=4", "schedule": "30 5 */3 * *" }
  ],
  "headers": [
    { "source": "/arts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/index.html", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] }
  ]
}
