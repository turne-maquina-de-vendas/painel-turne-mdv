# Copie para .env.local e preencha. O .env.local não vai para o git.
#
# Na Vercel só a DATABASE_URL precisa existir (Settings → Environment
# Variables). O resto da configuração mora na tabela `config` do banco —
# veja ferramentas/definir-config.mjs.

# Postgres do Neon — use a string COM "-pooler" no host: funções serverless
# abrem conexão a cada chamada e sem o pooler o limite estoura.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST-pooler.neon.tech/neondb?sslmode=require"

# Opcional na máquina. Em produção a chave vem da tabela `config`.
# PAGESPEED_API_KEY="sua-chave-aqui"
