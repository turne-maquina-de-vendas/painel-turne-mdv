# Copie para .env.local e preencha. O .env.local não vai para o git.
# As mesmas variáveis precisam existir na Vercel:
#   Settings → Environment Variables

# Postgres do Neon (Dashboard → Connection string, com pooler)
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require"

# Chave da PageSpeed Insights API (console.cloud.google.com)
# Sem ela a medição automática não roda: o Google devolve 429.
PAGESPEED_API_KEY="sua-chave-aqui"
